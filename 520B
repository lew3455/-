#include <bits/stdc++.h>
using namespace std;
int main() {
    int i,t;
    cin >>i>>t;
    int sum=0;
    bool r=false;
    while (t>i){
        r=true;
        if (t%2!=0){
            t++;
            sum++;
        }
        sum++;
        t=t/2;
    }
    if (r==true) sum+=(i%t);
    else sum+=abs(t-i);
    cout <<sum<<endl;
}
